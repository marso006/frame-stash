{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Label chests with item frames, then press G to stash and H to restock.",
  "authors": ["${mod_author}"],
  "license": "${mod_license}",
  "icon": "assets/frame_stash/icon.png",
  "contact": {
    "sources": "https://github.com/marso006/frame-stash",
    "issues": "https://github.com/marso006/frame-stash/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["com.framestash.fabric.FrameStashFabric"],
    "client": ["com.framestash.fabric.FrameStashFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_mc_range}",
    "java": ">=21"
  }
}
